defmodule <%= @mod %>.Pages.Home do
  @moduledoc "The default landing page, served at /."

  use Fractal.Page, path: "/", title: "Home"

  @impl Fractal.Page
  def render(_assigns) do
    tag(:section, [], [
      tag(:img, src: asset_path("logo.svg"), alt: "Fractal logo", class: "logo"),
      tag(:h1, [], ["Welcome to Fractal"]),
      tag(:p, [class: "lead"], [
        "An AI-first web framework for Elixir. This is your app's default page — ",
        "replace it when you have a real one."
      ]),
      tag(:h2, [], ["Build your first page"]),
      tag(:p, [], [
        "Prompt your agent: ",
        tag(:code, [], ["Create a Fractal page at /pricing that lists three plans"]),
        " — it will read the built-in guides, generate the page, and verify it. ",
        "In development this page reloads on its own when code changes."
      ]),
      tag(:h2, [], ["Registered pages"]),
      tag(:ul, [], page_links()),
      tag(:h2, [], ["Commands"]),
      tag(:ul, [], [
        tag(:li, [], [
          tag(:code, [], ["mix fractal.ai.docs"]),
          " — the docs agents read before writing code"
        ]),
        tag(:li, [], [
          tag(:code, [], ["mix fractal.gen.page Name"]),
          " — scaffold a page and its test (add ",
          tag(:code, [], ["--events a,b"]),
          " for an interactive one)"
        ]),
        tag(:li, [], [
          tag(:code, [], ["mix fractal.gen.resource Name field:type"]),
          " — scaffold a schema, migration, and pages with a form"
        ]),
        tag(:li, [], [
          tag(:code, [], ["mix fractal.verify"]),
          " — run Fractal's verification checks and the test suite"
        ])
      ])
    ])
  end

  @impl Fractal.Page
  def style do
    """
    .logo { width: 3.5rem; height: 3.5rem; }
    """
  end

  defp page_links do
    for page <- Fractal.Router.pages() do
      tag(:li, [], [
        tag(:a, [href: page.path()], [page.title()]),
        " — ",
        tag(:code, [], [page.path()])
      ])
    end
  end
end
